# 复制为 .env(本地)或填入 GitHub Secrets
# 从浏览器 F12 → Application → Cookies → aclclouds.com 复制:
ACL_SESSION=__Host-aclclouds_session 的值
ACL_REMEMBER=remember_web_59ba36addc2b2f9401580f014c7f58ea4e30989d 的值(可选)

# 指定服务器 ID(可选,留空自动续期所有服务)
ACL_SERVER_ID=

# 或使用邮箱密码(实验性)
ACL_EMAIL=
ACL_PASSWORD=

# 只查看状态,不实际续期
# DRY_RUN=1
